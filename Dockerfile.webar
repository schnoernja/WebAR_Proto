# syntax=docker/dockerfile:1

FROM node:22.23.2-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6 AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --prefix frontend

COPY scripts/build-frontend.mjs scripts/prepare-three-runtime.mjs scripts/runtime-files.mjs scripts/verify-dist.mjs ./scripts/
COPY frontend/index.html frontend/styles.css frontend/webxr.js ./frontend/
COPY frontend/ar ./frontend/ar
COPY frontend/assets ./frontend/assets
COPY frontend/models ./frontend/models
COPY frontend/public/sites ./frontend/public/sites
COPY frontend/vendor/8thwall ./frontend/vendor/8thwall

RUN npm --prefix frontend run build

FROM nginx:1.28.3-alpine3.23@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236 AS runtime

RUN rm -rf /usr/share/nginx/html \
    && mkdir -p /usr/share/nginx/html

COPY nginx.webar.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
